{
  "name": "seed-atlas-v2",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild:wasm": "node scripts/create-version-header.ts",
    "build:wasm": "docker build -f wasm/Dockerfile --output type=local,dest=public/wasm .",
    "test": "npm run typecheck && node --import ./tests/setup.ts --test tests/*.test.ts",
    "test:vanilla": "node scripts/create-samples.ts && powershell -ExecutionPolicy Bypass -File scripts/validate-vanilla.ps1",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
